{
	"name": "@cookielab.io/klovi-desktop",
	"version": "0.0.0",
	"commit": "",
	"description": "A native desktop app for browsing and presenting AI coding session history",
	"type": "module",
	"license": "MIT",
	"author": "Cookielab s.r.o.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cookielab/klovi.git"
	},
	"homepage": "https://github.com/cookielab/klovi",
	"bugs": {
		"url": "https://github.com/cookielab/klovi/issues"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "bun scripts/run-electrobun-cli.ts dev",
		"build": "bun scripts/run-electrobun-cli.ts build",
		"check": "bun run typecheck && bun run lint && bun run test",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test --preload ../../test-setup.ts",
		"test:integration": "true",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@cookielab.io/klovi-plugin-core": "workspace:*",
		"@cookielab.io/klovi-server": "workspace:*",
		"@cookielab.io/klovi-ui": "workspace:*",
		"@effect/platform": "*",
		"@effect/platform-bun": "*",
		"effect": "*",
		"electrobun": "^1.16.0"
	}
}

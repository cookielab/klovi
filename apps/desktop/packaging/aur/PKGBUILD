# Maintainer: Cookielab s.r.o. <engineering@cookielab.io>
pkgname=klovi-bin
pkgver=VERSION
pkgrel=1
pkgdesc="Desktop viewer for AI coding sessions"
arch=('x86_64' 'aarch64')
url="https://github.com/cookielab/klovi"
license=('MIT')
depends=('gtk3' 'nss' 'at-spi2-core' 'libdrm' 'libxcomposite' 'libxdamage' 'libxrandr' 'mesa' 'pango' 'cairo' 'alsa-lib')
options=('!strip')
source_x86_64=("${url}/releases/download/${pkgver}/klovi_${pkgver}_amd64.deb")
source_aarch64=("${url}/releases/download/${pkgver}/klovi_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

prepare() {
  bsdtar -xf data.tar.*
}

package() {
  install -dm755 "$pkgdir/opt"
  cp -a opt/klovi "$pkgdir/opt/"

  install -Dm644 usr/share/applications/klovi.desktop \
    "$pkgdir/usr/share/applications/klovi.desktop"

  for size in 16 32 128 256 512; do
    install -Dm644 "usr/share/icons/hicolor/${size}x${size}/apps/klovi.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/klovi.png"
  done

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/klovi/bin/launcher "$pkgdir/usr/bin/klovi"
}

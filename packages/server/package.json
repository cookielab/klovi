{
	"name": "@cookielab.io/klovi-server",
	"version": "0.0.0",
	"description": "Klovi — browse and present AI coding session history",
	"type": "module",
	"license": "MIT",
	"author": "Cookielab s.r.o.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cookielab/klovi.git"
	},
	"homepage": "https://github.com/cookielab/klovi",
	"bugs": {
		"url": "https://github.com/cookielab/klovi/issues"
	},
	"exports": {
		"./server": "./src/server.ts",
		"./effect/bootstrap": "./src/effect/bootstrap.ts",
		"./effect/http-app": "./src/effect/http-app.ts",
		"./effect/platform-bun": "./src/effect/platform-bun.ts",
		"./effect/plugin-runtime": "./src/effect/plugin-runtime.ts",
		"./effect/server-services": "./src/effect/server-services.ts",
		"./services/auto-discover": "./src/services/auto-discover.ts",
		"./services/onboarding-service": "./src/services/onboarding-service.ts",
		"./services/registry": "./src/services/registry.ts",
		"./services/sessions-service": "./src/services/sessions-service.ts",
		"./services/settings": "./src/services/settings.ts",
		"./services/settings-service": "./src/services/settings-service.ts",
		"./services/stats-service": "./src/services/stats-service.ts",
		"./services/version-service": "./src/services/version-service.ts"
	},
	"scripts": {
		"check": "bun run typecheck && bun run lint && bun run test",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test --preload ../../test-setup.ts -t '^(?!.*integration)'",
		"test:integration": "bun test --preload ../../test-setup.ts -t 'integration'",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"engines": {
		"bun": ">=1.3"
	},
	"dependencies": {
		"@cookielab.io/klovi-plugin-claude-code": "workspace:*",
		"@cookielab.io/klovi-plugin-codex": "workspace:*",
		"@cookielab.io/klovi-plugin-core": "workspace:*",
		"@cookielab.io/klovi-plugin-cursor": "workspace:*",
		"@cookielab.io/klovi-plugin-opencode": "workspace:*",
		"effect": "3.22.0",
		"@effect/platform": "0.97.0",
		"@effect/platform-bun": "0.91.0",
		"@effect/platform-node": "0.108.0"
	}
}

{
	"name": "@cookielab.io/klovi-ui",
	"version": "0.0.0",
	"private": true,
	"description": "Shared application UI for Klovi",
	"type": "module",
	"exports": {
		"./bootstrap": "./src/bootstrap.tsx",
		"./styles": "./src/styles.ts",
		"./app/*": "./src/app/*"
	},
	"scripts": {
		"dev": "bun run build.ts --watch",
		"build": "bun run build.ts --minify",
		"check": "bun run typecheck && bun run lint && bun run test",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test --preload ../../test-setup.ts",
		"test:integration": "true",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@cookielab.io/klovi-design-system": "workspace:*",
		"@cookielab.io/klovi-plugin-claude-code": "workspace:*",
		"@cookielab.io/klovi-plugin-codex": "workspace:*",
		"@cookielab.io/klovi-plugin-core": "workspace:*",
		"@cookielab.io/klovi-plugin-cursor": "workspace:*",
		"@cookielab.io/klovi-plugin-opencode": "workspace:*",
		"@cookielab.io/klovi-ui-components": "workspace:*",
		"effect": "3.21.1",
		"react": "19.2.5",
		"react-dom": "19.2.5"
	},
	"devDependencies": {
		"@testing-library/react": "16.3.2"
	}
}

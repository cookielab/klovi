{
	"name": "@cookielab.io/klovi-design-system",
	"version": "0.1.0",
	"description": "Design system components and tokens for Klovi",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts",
		"./globals": "./src/globals/index.ts"
	},
	"sideEffects": ["src/globals/**"],
	"files": ["src"],
	"scripts": {
		"check": "bun run typecheck && bun run lint && bun run test",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test --preload ../../test-setup.ts",
		"test:integration": "true",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"ladle": "ladle serve --port 6006",
		"ladle:build": "ladle build"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"dependencies": {
		"@fontsource/dm-sans": "5.2.8",
		"@fontsource/ibm-plex-mono": "5.2.7",
		"react-syntax-highlighter": "16.1.1"
	},
	"devDependencies": {
		"@ladle/react": "5.1.1",
		"@tailwindcss/vite": "4.3.0",
		"@testing-library/react": "16.3.2",
		"@types/react-syntax-highlighter": "15.5.13",
		"vite": "8.0.14"
	}
}

{
  "name": "@cookielab.io/klovi-workspace",
  "private": true,
  "description": "Workspace for the Klovi monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @cookielab.io/klovi-desktop dev",
    "dev:desktop": "bun run --filter @cookielab.io/klovi-desktop dev",
    "dev:web": "bun run --filter @cookielab.io/klovi-web dev",
    "dev:server": "bun run --filter @cookielab.io/klovi start",
    "build": "bun run --filter @cookielab.io/klovi-desktop build",
    "build:web": "bun run --filter @cookielab.io/klovi-web build",
    "test": "bun test",
    "test:node-smoke": "npx tsx scripts/plugin-runtime-node-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "storybook": "bun run --filter @cookielab.io/klovi-design-system storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@effect/platform": "^0.94.5",
    "@effect/platform-bun": "^0.87.1",
    "@effect/platform-node": "^0.104.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.8",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "chrome-devtools-mcp": "^0.18.1",
    "effect": "^3.19.19",
    "happy-dom": "^20.5.0",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "electrobun@1.14.4": "patches/electrobun@1.14.4.patch"
  }
}

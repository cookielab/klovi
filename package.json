{
	"name": "@cookielab.io/klovi-workspace",
	"private": true,
	"description": "Workspace for the Klovi monorepo",
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:desktop": "bun run --filter @cookielab.io/klovi-desktop dev",
		"dev:bun": "bun run build:web && bun run --filter @cookielab.io/klovi dev",
		"dev:node": "tsx apps/package/src/cli.ts",
		"build": "bun run --filter @cookielab.io/klovi-desktop build",
		"build:web": "bun run --filter @cookielab.io/klovi-ui build",
		"build:package": "bun run build:web && bun run --filter @cookielab.io/klovi build",
		"stage:npm": "bun run build:web && bun run --filter @cookielab.io/klovi stage:npm",
		"verify:packed-artifact": "bun scripts/verify-packed-artifact.ts",
		"check": "bun run typecheck && bun run lint && bun run test",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun run --filter '*' test:unit",
		"test:integration": "bun run --filter '*' test:integration",
		"test:node-smoke": "tsx scripts/plugin-runtime-node-smoke.ts",
		"typecheck": "bun run --filter '*' typecheck",
		"format": "biome format --write .",
		"lint": "bun run --filter '*' lint",
		"lint:fix": "bun run --filter '*' lint:fix",
		"ladle": "bun run --filter @cookielab.io/klovi-design-system ladle",
		"ladle:build": "bun run --filter @cookielab.io/klovi-design-system ladle:build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@cookielab.io/biome-config": "2.1.0",
		"@cookielab.io/typescript-config": "0.1.2",
		"@tailwindcss/vite": "4.3.2",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"bun-plugin-tailwind": "0.1.2",
		"effect": "3.21.2",
		"happy-dom": "20.10.6",
		"tailwindcss": "4.3.2",
		"tsx": "4.23.0",
		"typescript": "6.0.3"
	},
	"patchedDependencies": {
		"electrobun@1.18.0": "patches/electrobun@1.18.0.patch",
		"@cookielab.io/typescript-config@0.1.0": "patches/@cookielab.io%2Ftypescript-config@0.1.0.patch"
	}
}

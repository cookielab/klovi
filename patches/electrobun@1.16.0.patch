+function execSyncWithRetries(
+	command: string,
+	options: Parameters<typeof execSync>[1],
+	retries = 3,
+): void {
+	for (let attempt = 1; attempt <= retries; attempt++) {
+		try {
+			execSync(command, options);
+			return;
+		} catch (error) {
+			const message = error instanceof Error ? error.message : String(error);
+			if (!message.includes("Resource busy") || attempt === retries) {
+				throw error;
+			}
+
+			console.warn(
+				`Command hit a transient resource lock, retrying (${attempt}/${retries}): ${command}`,
+			);
+			Bun.sleepSync(attempt * 1000);
+		}
+	}
+}
